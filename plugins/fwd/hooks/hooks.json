{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/pr-review/gate-hook.sh",
            "if": "Bash(*merge*)",
            "timeout": 60,
            "statusMessage": "pr-review: checking the merge bar"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/pr-review/gate-hook.sh",
            "if": "Bash(gh api *requested_reviewers*)",
            "timeout": 60,
            "statusMessage": "pr-review: checking the re-request is earned"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/pr-review/gate-hook.sh",
            "if": "Bash(*request-copilot-review*)",
            "timeout": 60,
            "statusMessage": "pr-review: checking the re-request is earned"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/pr-review/gate-hook.sh",
            "if": "Bash(*requestReviews*)",
            "timeout": 60,
            "statusMessage": "pr-review: checking the re-request is earned"
          }
        ]
      },
      {
        "matcher": "mcp__neon__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/neon-prod-guard.mjs",
            "timeout": 15,
            "statusMessage": "neon guard: checking for production writes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/autonomous-guard.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-budget.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-budget.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
