{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/pr-review/gate-hook.sh",
            "if": "Bash(*gh pr merge*)",
            "timeout": 60,
            "statusMessage": "pr-review: checking the merge bar"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/pr-review/gate-hook.sh",
            "if": "Bash(gh api *requested_reviewers*)",
            "timeout": 60,
            "statusMessage": "pr-review: checking the re-request is earned"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/pr-review/gate-hook.sh",
            "if": "Bash(*pulls/*/merge*)",
            "timeout": 60,
            "statusMessage": "pr-review: checking the merge bar"
          }
        ]
      }
    ]
  }
}
